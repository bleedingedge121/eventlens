# EventLens Environment Configuration
# Copy this file to .env and adjust variables as needed

# Local Ollama Inference Server
OLLAMA_HOST=http://localhost:11434
VLM_MODEL=qwen2.5-vl:7b
CHAT_MODEL=Hermes-4-14B:latest
OLLAMA_TIMEOUT_SECONDS=15

# Vision Pipeline & Acceleration
YOLO_MODEL=yolo11s-pose.pt
YOLO_DEVICE=cuda:0
TARGET_FPS=4
CONFIDENCE_THRESHOLD=0.35

# Storage Paths
DATABASE_PATH=data/events.db
FRAMES_DIR=data/frames
VIDEOS_DIR=data/videos

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true
